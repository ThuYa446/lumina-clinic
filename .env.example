# Docker Compose reads this file after you copy it to .env.
# Local demo defaults only. Replace passwords/secrets before an internet deployment.
POSTGRES_PORT=5433
DATABASE_URL=jdbc:postgresql://localhost:5433/lumina
DB_USERNAME=lumina
DB_PASSWORD=lumina-local-only
STAFF_USERNAME=receptionist
STAFF_PASSWORD=local-reception-only
BOOKING_TOKEN_SECRET=local-demo-token-secret-change-before-deploy-123456789
DEMO_MEMBER_CODE=LUMINA-DEMO
DEMO_MEMBER_EMAIL=member@example.com
DEMO_PAYMENTS_ENABLED=true

# Render / Neon example (set in Render's secret environment, never commit credentials):
# DATABASE_URL=jdbc:postgresql://YOUR-DIRECT-HOST.neon.tech:5432/neondb?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
# DB_USERNAME=<Neon role>
# DB_PASSWORD=<Neon password>
